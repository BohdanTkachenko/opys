# The node's web UI bundle is a generated, committed build product (ADR-0078):
# `ui-build` regenerates it and CI fails if it drifts from its sources. Collapse
# it in reviews so a bundle rebuild does not bury the diff that caused it.
opys-server/ui/dist/** linguist-generated=true
opys-server/ui/package-lock.json linguist-generated=true

# EOL normalization is what would break the drift gate, on both sides of it.
#
# The *sources* are pinned to LF because the bundle is a function of their bytes:
# with core.autocrlf=true (a Windows contributor's default) vite would compile
# CRLF input to a different bundle, which CI — rebuilding from LF sources —
# reports as drift that no rebuild can fix. (`text=auto` rather than `text`, so
# a binary that lands here one day — an icon, a sample image — is left alone.)
opys-server/ui/** text=auto eol=lf

# The *bundle* is pinned to no normalization at all, because it is the artifact
# being compared: git must hand out exactly the bytes that were committed. Last
# match wins, so this overrides the line above for dist/.
opys-server/ui/dist/** -text
