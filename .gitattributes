# The lockfile is generated by npm and reviewed as an artifact, not as prose.
opys-server/ui/package-lock.json linguist-generated=true

# EOL normalization would change what the UI sources compile to.
#
# The bundle is not committed (ADR-0086) — it is built by `ui-build`, by the Nix
# derivation, and by the release job before `cargo publish`. Those three must
# agree, and they only do if every checkout sees the same source bytes: with
# core.autocrlf=true (a Windows contributor's default) vite would compile CRLF
# input to a different bundle than CI and Nix produce from LF. Pinning the
# sources to LF is what keeps the three paths byte-identical.
#
# (`text=auto` rather than `text`, so a binary that lands here one day — an
# icon, a sample image — is left alone.)
opys-server/ui/** text=auto eol=lf
